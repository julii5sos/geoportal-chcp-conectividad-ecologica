# Proyecto de cuota de Google Earth Engine. No incluya credenciales en este archivo.
GEE_PROJECT_ID=geoportal-513817

# Servidor web local.
HOST=127.0.0.1
PORT=8080

# Caché efímera en memoria. Se pierde al reiniciar el proceso.
WEB_RESULT_CACHE_ENTRIES=6
WEB_RESULT_CACHE_TTL=3600

# Límites conservadores de solicitudes públicas.
WEB_MAX_AREA_HA=50000
WEB_MAX_GEOMETRY_VERTICES=5000

# Assets institucionales. La identidad de ejecución debe tener permiso de lectura.
SINIA_2021_FOREST_ASSET=projects/geoportal-513817/assets/SINIA_2021_COBERTURA_GENERAL_VECTOR
SINIA_2023_FOREST_ASSET=projects/geoportal-513817/assets/SINIA_2023_COBERTURA_GENERAL_RASTER10M
